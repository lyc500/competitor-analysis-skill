  "task": {
    "raw_request": "根据虎牙我的页现状，搜集简化布局、突出常用功能、强化会员和任务中心、收起其他功能的竞品参考页面。",
    "research_goal": "收集真实移动 App 个人中心单屏，比较常用功能、会员权益、任务激励、低频服务的视觉层级和收纳方式，形成带来源、版本边界和借鉴建议的图墙。",
    "target_page": "我的／个人中心",
    "target_surface": "mobile_app",
    "platforms": [
      "iOS",
      "Android"
    ],
